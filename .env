# Configuración por defecto del frontend. Este archivo SÍ se sube al repositorio:
# con solo clonar, instalar y ejecutar `pnpm dev` el inicio de sesión ya funciona.
#
# Los valores de Firebase de abajo son la configuración pública del cliente web: viajan en el
# JavaScript que descarga cualquier navegador y no dan acceso a nada por sí solos. La seguridad
# está en la API, que valida el token de cada sesión.
#
# Para usar otros valores en tu máquina crea un archivo .env.local (no se sube) y sobrescribe ahí.

VITE_API_BASE_URL=/api
# Donde corre la API en desarrollo (perfil "http" de dotnet run)
VITE_API_PROXY_TARGET=http://localhost:5295

VITE_FIREBASE_API_KEY=AIzaSyC3_YgRE4dy8ru4wY7bigTzwv6WjSzGBGg
VITE_FIREBASE_AUTH_DOMAIN=eventosperuia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eventosperuia
VITE_FIREBASE_APP_ID=1:944762496935:web:bdbc9b8efc8894be4ff882
